{
  "name": "mythos",
  "version": "0.1.0",
  "private": true,
  "description": "MYTHOS — an interactive 3D atlas of Greek mythology with a two-clock model of mythic and historical time.",
  "license": "MIT",
  "scripts": {
    "dev": "next dev",
    "build": "npm run validate && next build",
